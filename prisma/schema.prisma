

generator client {

  provider = "prisma-client-js"
}


datasource db {

  provider = "sqlite"  
}

// Fornecedor

model Fornecedor {
  
  id          Int         @id  @default(autoincrement())
  nome        String
  cnpj        String      @unique
  pastilhas   Pastilha[]
}


// pastilhas

model Pastilha {
  
  id               Int             @id  @default(autoincrement())
  codigo           String          @unique       //codigo que identifica as pastilhas
  descricao        String
  estoqueAtual     Int             @default(0)
  estoqueMinimo    Int             // quando alcanca faz o alerta
  fornecedorId     Int
  fornecedor       Fornecedor      @relation(fields: [fornecedorId], references: [id])
  movimentacoes    Movimentacao[]  

}


// Movimentacao

model Movimentacao {

  id          Int      @id @default(autoincrement())
  tipo        String   // "ENTRADA" ou "SAIDA"
  quantidade  Int
  data        DateTime @default(now())
  pastilhaId  Int
  motivo      String?
  pastilha    Pastilha @relation(fields: [pastilhaId], references: [id])

}